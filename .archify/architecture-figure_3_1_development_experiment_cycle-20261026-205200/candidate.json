  "cards": [
    {
      "dot": "cyan",
      "title": "Pre-flight Verification (Stages 1–5)",
      "items": [
        "Pre-registers hypotheses (H1–H5), statistical power, and seed ranges prior to execution",
        "Implements multi-agent simulation harness, manager/developer/auditor agents, and dashboard",
        "Pilot runner executes seeds 9001–9005 to verify Ollama daemon availability and response schemas"
      ]
    },
    {
      "dot": "rose",
      "title": "Validation Decision Gate",
      "items": [
        "Inspects execution logs, deterministic subtask ground truth, and output data contracts",
        "No (Config Defect): Returns to Stage 2 to re-tune parameter cells, prompt text, or seed sets",
        "No (Runtime Bug): Returns to Stage 3 to remediate simulation code, agent logic, or API models",
        "Yes (Validated): Authorizes execution of the 600-run full factorial campaign"
      ]
    },
    {
      "dot": "emerald",
      "title": "Campaign Execution & Synthesis (Stages 6–8)",
      "items": [
        "Executes 600 sprint simulations generating 2,400 agent observations across 57 condition cells",
        "Applies cluster-robust regression, ANOVA, and detection rate metrics to test deception dynamics",
        "Identifies model and protocol limitations to refine architecture in subsequent research phases"
      ]
    }
  ]
