  "cards": [
    {
      "dot": "cyan",
      "title": "Preparation & Preflight (Stages 1–3)",
      "items": [
        "Loads model configuration (qwen2.5:7b, temperature 0.3) from config/settings.py and environment pressure tiers",
        "Executes preflight check (test_pilot_runner.py) to confirm Ollama daemon availability and directory write permissions",
        "Generates deterministic factorial condition matrix (600 runs, 2400 agent trials) across 4 developer roles with seed isolation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution & Logging (Stages 4–6)",
      "items": [
        "SoftwareCompanySimulator runs sprint loop: Manager assigns tasks, developers simulate work, and AuditorAgent scores suspicion",
        "Provenance tracking synchronously captures git commit HEAD, exact LLM prompts, and raw unparsed responses alongside execution",
        "ExperimentResult records are serialized and persisted into results/factorial_campaign/ with full reproducibility metadata"
      ]
    },
    {
      "dot": "amber",
      "title": "Validation & Synthesis (Stages 7–9)",
      "items": [
        "Integrity gate validates schema conformance, non-null metrics, and verifies historical results CSV was not overwritten",
        "run_analysis.py calculates descriptive statistics, correlation matrices, logistic regression detection, and generates PNG charts",
        "Dual presentation: FastAPI backend serves the React 19 dashboard over REST, while Streamlit provides direct filesystem exploration"
      ]
    }
  ]
