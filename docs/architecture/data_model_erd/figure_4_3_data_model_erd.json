  "cards": [
    {
      "dot": "cyan",
      "title": "Factorial Experiment Core",
      "items": [
        "ExperimentResult represents the primary unit of observation across 2,400 factorial runs (6 scenarios x 4 auditors x 5 models x 2 observation levels x 10 runs).",
        "CompanyPolicy specifies organizational deadline, completion reward, and penalty disincentives generated per pressure tier.",
        "Task defines the modular sprint work assigned by the manager agent to the developer agent."
      ]
    },
    {
      "dot": "amber",
      "title": "Telemetry & Auditor Provenance",
      "items": [
        "ProvenanceData captures verbatim LLM system/user prompts, raw completion tokens, and the exact git commit SHA for complete experimental reproducibility.",
        "AuditResult stores suspicion scores, severity tiers, and LLM-generated explanations from the AuditorAgent.",
        "ExperimentEvent records fine-grained chronological lifecycle events emitted during simulation execution."
      ]
    },
    {
      "dot": "emerald",
      "title": "Phase 5B Synthetic Ground Truth",
      "items": [
        "GroundTruthState maintains a 10-bit deterministic binary state vector with a verifiable SHA-256 integrity checksum.",
        "SubtaskResult tracks individual functional unit test pass/fail states and execution times without physical compiler dependencies.",
        "ExperimentResultV2 measures autonomous LLM strategy selection against verified ground truth, persisted atomically into sprint checkpoints."
      ]
    }
  ]
}