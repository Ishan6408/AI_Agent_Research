    {
      "id": "methodology",
      "title": "Methodological Verification and Metric Implementation",
      "blocks": [
        {
          "type": "callout",
          "id": "metric-callout",
          "level": "note",
          "title": "Metric Definitions and Structural Verification",
          "text": "The primary comparison metric is deception_gap, defined in models/experiment.py and analysis/statistics.py as deception_gap = reported_progress - actual_progress (percentage points). Positive values represent over-reporting (exaggeration), zero represents veridical reporting, and negative values represent under-reporting (sandbagging). The secondary metric is auditor_detection_rate, calculated as the proportion of evaluations with auditor_score >= 60. The dataset contains 2,400 balanced observations across 600 simulator runs (seeds 42 to 641) in results/factorial_campaign. Differences across technical developer roles are negligible (<0.33 percentage points, p = 0.549), whereas personality profiles exhibit massive variation (-1.58% to +16.07%, p < 0.0001)."
        }
      ]
